{
  "name": "@podo/editor",
  "version": "0.0.0",
  "type": "module",
  "description": "Design-system development editor for Podo specs.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@podo/edit-core": "workspace:*",
    "@podo/spec": "workspace:*",
    "tldraw": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@podo/tokens": "workspace:*",
    "vite": "^8.0.16"
  }
}
